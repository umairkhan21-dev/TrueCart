{
    "manifest_version": 3,
    "name": "TrueCart",
    "version": "1.0.1",
    "description": "See real product reviews before you buy",
    "permissions": [
        "activeTab",
        "scripting",
        "tabs",
        "storage"
    ],
    "host_permissions": [
        "https://www.amazon.in/*",
        "https://www.amazon.com/*",
        "https://www.flipkart.com/*",
        "https://flipkart.com/*",
        "https://www.myntra.com/*",
        "https://myntra.com/*",
        "https://www.meesho.com/*",
        "https://meesho.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.amazon.in/*",
                "https://www.amazon.com/*",
                "https://www.flipkart.com/*",
                "https://flipkart.com/*",
                "https://www.myntra.com/*",
                "https://myntra.com/*",
                "https://www.meesho.com/*",
                "https://meesho.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "action": {
        "default_title": "TrueCart",
        "default_popup": "dist/index.html"
    },
    "icons": {
        "16": "icons/truecart16.png",
        "32": "icons/truecart32.png",
        "48": "icons/truecart48.png",
        "128": "icons/truecart128.png"
    }
}